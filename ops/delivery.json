{
  "repo": "lucas045057-eng/agent-template",
  "internal": ["PROJECT.md", "PROGRESS.md", "QUALITY.md", "docs/**/*.md"],
  "check": { "workflow": "check.yml", "job": "check" },
  "ship": { "workflow": "ship.yml" },
  "review": {
    "points": "AGENTS.md",
    "status": "agent-review",
    "xhigh": [".github/**/*.yml", "ops/*.json", "scripts/features.mjs", "scripts/verify-feature.sh", "AGENTS.md"]
  },
  "health": {
    "url": "https://lucas045057-eng.github.io/agent-template/version.json",
    "field": "commit",
    "pattern": "(?P<sha>[0-9a-f]{40})",
    "require": { "ok": true }
  }
}
